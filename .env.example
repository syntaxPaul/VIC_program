# SQLite by default. See README for switching to PostgreSQL.
DATABASE_URL="file:./prisma/dev.db"

# CHANGE THIS. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-character-string"

# Where member and asset photos are stored. In production point this at a
# mounted volume so uploads survive a redeploy.
UPLOAD_DIR="./storage/uploads"
