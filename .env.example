# ── database ─────────────────────────────────────────────────────────
# Local development (matches the docker command in DEPLOYMENT.md):
DATABASE_URL="postgresql://vic:vicdev@localhost:5432/church?schema=public"
# In production this is set as a Container App secret by deploy/02-deploy.sh.

# ── sessions ─────────────────────────────────────────────────────────
# CHANGE THIS. Generate with: openssl rand -base64 32
# Rotating it signs everyone out.
AUTH_SECRET="change-me-to-a-random-32-character-string"

# ── photo storage ────────────────────────────────────────────────────
# Leave AZURE_STORAGE_ACCOUNT_NAME unset for local development and photos
# are written to UPLOAD_DIR. Set it and photos go to Azure Blob Storage.
UPLOAD_DIR="./storage/uploads"
# AZURE_STORAGE_ACCOUNT_NAME="stvicchurch"
# AZURE_STORAGE_CONTAINER="uploads"
# AZURE_CLIENT_ID="<managed identity client id>"
